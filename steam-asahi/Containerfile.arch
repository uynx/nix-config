FROM docker.io/menci/archlinuxarm@sha256:6549bc2de3848c482a4c411b5c29a356e9b5bcba89f6d051cc957c861d656eb5

# pacman 7 sandboxes downloads with Landlock, which cannot be applied inside a
# docker build; --disable-sandbox is required here, not a preference. Unlike
# the Fedora image this cannot pin versions — pacman has no NEVRA equivalent —
# so this variant tracks whatever asahi-alarm currently ships. `pacman-key
# --init` is likewise required: the base image ships no local master key, so
# the asahi-alarm keyring's install hook cannot sign it and the repo's own
# signatures come back "unknown trust". No gtk2 either — Arch dropped it from
# the repos, so `steam-asahi-run` symlinks that one in from the nix store; the
# rest of what Valve's arm64 steamui.so needs is here. The asahi-alarm repo
# must come *before* core and extra, and its packages are written
# `asahi-alarm/<name>` on top of that: pacman resolves a bare name by repo
# order, so appending it left plain `mesa` meaning stock Arch's — no asahi
# Vulkan driver, no venus ICD, no GPU in the guest. Ordering is what binds
# distrobox's own pacman calls during container setup, which the explicit
# prefixes cannot reach. Those setup calls also drag in Arch's split
# `vulkan-mesa-implicit-layers`, whose two files asahi's monolithic mesa
# already owns; installing it here with --overwrite is what stops distrobox
# from dying on the file conflict every time the container is created.
#
# The two pacman steps are separate layers sharing one package cache: editing
# the list below then costs an install, not a re-download of the whole distro.
RUN --mount=type=cache,target=/var/cache/pacman/pkg,sharing=locked \
    pacman -Syu --noconfirm --disable-sandbox curl && \
    pacman-key --init && \
    pacman-key --populate && \
    curl -fsSL -o /tmp/keyring.pkg.tar.xz \
      https://github.com/asahi-alarm/asahi-alarm/releases/download/aarch64/asahi-alarm-keyring-20241216-1-any.pkg.tar.xz && \
    echo '798f4b283ad2819aee950d042f26566ae1a68f87c12247301ce449bea3b2d81e  /tmp/keyring.pkg.tar.xz' \
      | sha256sum -c - && \
    pacman -U --noconfirm --disable-sandbox /tmp/keyring.pkg.tar.xz && \
    rm /tmp/keyring.pkg.tar.xz && \
    sed -i '/^\[core\]/i [asahi-alarm]\nServer = https://github.com/asahi-alarm/asahi-alarm/releases/download/$arch\n' \
      /etc/pacman.conf

RUN --mount=type=cache,target=/var/cache/pacman/pkg,sharing=locked \
    pacman -Sy --noconfirm --disable-sandbox \
      asahi-alarm/muvm \
      asahi-alarm/libkrun \
      asahi-alarm/libkrunfw \
      asahi-alarm/virglrenderer \
      asahi-alarm/mesa \
      asahi-alarm/FEX-Emu \
      asahi-alarm/fex-emu-rootfs-arch \
      asahi-alarm/mesa-fex-emu-overlay-x86_64 \
      asahi-alarm/mesa-fex-emu-overlay-i386 \
      asahi-alarm/steam \
      xorg-xwayland \
      libglvnd \
      vulkan-icd-loader \
      fontconfig \
      freetype2 \
      harfbuzz \
      libx11 \
      libxcomposite \
      libxcursor \
      libxext \
      libxfixes \
      libxi \
      libxinerama \
      libxrandr \
      libxrender \
      libxxf86vm \
      libxkbcommon \
      sdl3 \
      sdl2-compat \
      libpulse \
      alsa-lib \
      libsndfile \
      ibus \
      networkmanager \
      nss \
      openal \
      libvdpau \
      python \
      python-requests \
      sudo && \
    pacman -S --noconfirm --disable-sandbox \
      --overwrite '/usr/lib/libVkLayer_MESA_device_select.so' \
      --overwrite '/usr/share/vulkan/implicit_layer.d/VkLayer_MESA_device_select.json' \
      vulkan-mesa-implicit-layers && \
    rm -rf /tmp/* /var/tmp/*

# No Box64 here on purpose. It exists in the Fedora image only because Stick
# Fight stalled under FEX, which turned out to be the Fedora FEX rootfs rather
# than FEX itself. Under this variant that game uses proton_10 like the rest.

# Fedora's wrapper normally downloads this into mutable user state on first
# launch. Bake the fixed, hash-verified Valve bootstrap into the image instead.
RUN python3 -c 'import requests; open("/tmp/steam.tar.gz", "wb").write(requests.get("https://repo.steampowered.com/steam/archive/stable/steam_1.0.0.81.tar.gz").content)' && \
    echo '1a26b9d7cdace09e04dc86b511e0b9923257f664a5b6cafe6fed5e46d117b4f9  /tmp/steam.tar.gz' | sha256sum -c - && \
    mkdir -p /opt/fex-steam && \
    python3 -c 'import tarfile; names=["steam-launcher/steam_subscriber_agreement.txt", "steam-launcher/bin_steam.sh", "steam-launcher/bootstraplinux_ubuntu12_32.tar.xz"]; archive=tarfile.open("/tmp/steam.tar.gz"); archive.extractall("/opt/fex-steam", members=[archive.getmember(name) for name in names], filter="data")' && \
    rm /tmp/steam.tar.gz

# Valve's ARM64 public beta avoids running Steam's desktop UI through FEX. The
# client updates this bootstrap in persistent user state after first launch.
RUN python3 -c 'import requests; open("/tmp/steam-arm64.zip", "wb").write(requests.get("https://client-update.steamstatic.com/bins_linuxarm64_linuxarm64.zip.f122d0dc522cbd4d450fcfebc3552274b66b82e0").content)' && \
    echo 'a61e993476fa4e06b8a50f29f7bff9211367be7cf57c8bacb30544e384feaf15  /tmp/steam-arm64.zip' | sha256sum -c - && \
    mkdir -p /opt/steam-arm64 && \
    python3 -c 'import zipfile; zipfile.ZipFile("/tmp/steam-arm64.zip").extractall("/opt/steam-arm64")' && \
    chmod -R 0755 /opt/steam-arm64/steamrtarm64 && \
    rm /tmp/steam-arm64.zip

# Same oversized Qt bootstrap splash as the Fedora wrapper. Guarded because
# Arch's steam package is not Fedora's and may not carry the line at all.
RUN [ -f /usr/bin/steam ] && \
    sed -i 's/^show_splash = True/show_splash = False/' /usr/bin/steam || true

# muvm's --execute-pre accepts an executable path (without arguments). Run
# this as root in the guest before Steam so large Windows games have enough
# virtual memory map slots.
COPY steam-guest-tune /usr/local/libexec/steam-guest-tune
RUN chmod 0755 /usr/local/libexec/steam-guest-tune

CMD ["/bin/bash"]
