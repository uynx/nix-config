FROM quay.io/fedora/fedora-minimal@sha256:098913134916e02acd3e282c10023e277637cb81dbff1f100edd2159b3ba0b9d

# updates keeps only the newest build of each package; without the archive the exact pins below stop resolving.
RUN printf '%s\n' '[updates-archive]' \
      'name=Fedora $releasever - $basearch - Updates Archive' \
      'baseurl=https://fedoraproject-updates-archive.fedoraproject.org/fedora/$releasever/$basearch/' \
      'gpgcheck=1' \
      'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-$basearch' \
      'cost=10000' > /etc/yum.repos.d/fedora-updates-archive.repo

RUN --mount=type=cache,target=/var/cache/libdnf5 \
    dnf install -y --setopt=keepcache=True --setopt=max_parallel_downloads=20 \
      fex-emu-2604-1.fc44.aarch64 \
      'fex-emu-rootfs-fedora-44^20260410.n.0-1.fc44.noarch' \
      erofs-fuse-1.9.4-1.fc44.aarch64 \
      python3-3.14.7-1.fc44.aarch64 \
      mesa-dri-drivers-26.2.3-1.fc44.aarch64 \
      mesa-vulkan-drivers-26.2.3-1.fc44.aarch64 \
      gtk2-2.24.33-25.fc44.aarch64 \
      ibus-1.5.34-4.fc44.aarch64 \
      NetworkManager-1.56.1-2.fc44.aarch64 \
      nss-3.129.0-1.fc44.aarch64 \
      openal-soft-1.24.2-6.fc44.aarch64 \
      libvdpau-1.5-11.fc44.aarch64 \
      fontconfig-devel-2.17.0-4.fc44.aarch64 \
      freetype-devel-2.14.3-1.fc44.aarch64 \
      harfbuzz-devel-14.1.0-2.fc44.aarch64 \
      libX11-devel-1.8.13-3.fc44.aarch64 \
      libXcomposite-devel-0.4.6-7.fc44.aarch64 \
      libXcursor-devel-1.2.3-4.fc44.aarch64 \
      libXext-devel-1.3.6-5.fc44.aarch64 \
      libXfixes-devel-6.0.1-7.fc44.aarch64 \
      libXi-devel-1.8.3-1.fc44.aarch64 \
      libXinerama-devel-1.1.5-10.fc44.aarch64 \
      libXrandr-devel-1.5.4-7.fc44.aarch64 \
      libXrender-devel-0.9.12-4.fc44.aarch64 \
      libXxf86vm-devel-1.1.6-4.fc44.aarch64 \
      libxkbcommon-devel-1.13.1-2.fc44.aarch64 \
      mesa-libGL-devel-26.2.3-1.fc44.aarch64 \
      pulseaudio-libs-17.0-9.fc44.aarch64 \
      vulkan-loader-1.4.341.0-1.fc44.aarch64 \
      vulkan-loader-devel-1.4.341.0-1.fc44.aarch64 \
      xorg-x11-server-Xwayland-24.1.13-1.fc44.aarch64 && \
    rm -rf /tmp/* /var/tmp/*

RUN printf '%s\n' '{"Config":{"RootFS":"/usr/share/fex-emu/RootFS/default.erofs"}}' \
      > /usr/share/fex-emu/Config.json

# curl -f + --retry-all-errors: a transient edge-cache 403 must not surface as a fake checksum mismatch.
RUN curl -fsSL --retry 3 --retry-all-errors --retry-delay 5 \
      --connect-timeout 10 --max-time 300 \
      -o /tmp/steam-arm64.zip \
      "https://client-update.steamstatic.com/bins_linuxarm64_linuxarm64.zip.f122d0dc522cbd4d450fcfebc3552274b66b82e0" && \
    echo 'a61e993476fa4e06b8a50f29f7bff9211367be7cf57c8bacb30544e384feaf15  /tmp/steam-arm64.zip' | sha256sum -c - && \
    mkdir -p /opt/steam-arm64 && \
    python3 -c 'import zipfile; zipfile.ZipFile("/tmp/steam-arm64.zip").extractall("/opt/steam-arm64")' && \
    chmod -R 0755 /opt/steam-arm64/steamrtarm64 && \
    rm /tmp/steam-arm64.zip

CMD ["/bin/bash"]
