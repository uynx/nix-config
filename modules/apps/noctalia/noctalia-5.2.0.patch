+void LockSurface::oskType(std::string_view text) {
+  if (m_authenticating || m_passwordField == nullptr) {
+    return;
+  }
+  std::string value = m_passwordField->value();
+  value += text;
+  m_passwordField->setValue(value);
+  if (m_onPasswordChanged) {
+    m_onPasswordChanged(value);
+  }
+}
+
+void LockSurface::oskBackspace() {
+  if (m_authenticating || m_passwordField == nullptr || m_passwordField->value().empty()) {
+    return;
+  }
+  std::string value = m_passwordField->value();
+  while (!value.empty() && (static_cast<unsigned char>(value.back()) & 0xC0U) == 0x80U) {
+    value.pop_back();
+  }
+  if (!value.empty()) {
+    value.pop_back();
+  }
+  m_passwordField->setValue(value);
+  if (m_onPasswordChanged) {
+    m_onPasswordChanged(value);
+  }
+}
+
+void LockSurface::oskSetShift(bool shift) {
+  m_oskShift = shift;
+  for (std::size_t i = 0; i < m_oskKeys.size(); ++i) {
+    const char c = oskKeyChar(i, m_oskShift, m_oskCaps, m_oskSymbols);
+    m_oskKeys[i]->setVisible(c != '\0');
+    if (c != '\0') {
+      m_oskKeys[i]->setText(std::string(1, c));
+    }
+  }
+  if (!m_oskWideKeys.empty()) {
+    m_oskWideKeys.front()->setVariant(m_oskShift || m_oskCaps ? ButtonVariant::Primary : ButtonVariant::Secondary);
+    m_oskWideKeys.front()->setGlyph(m_oskCaps ? "arrow-big-up-lines" : "arrow-big-up");
+  }
+}
+
+void LockSurface::oskShiftTapped() {
+  const auto now = std::chrono::steady_clock::now();
+  const bool doubleTap = m_oskShift && now - m_oskShiftTap < std::chrono::milliseconds(400);
+  m_oskShiftTap = now;
+  if (m_oskCaps) {
+    m_oskCaps = false;
+    oskSetShift(false);
+  } else if (doubleTap) {
+    m_oskCaps = true;
+    oskSetShift(false);
+  } else {
+    oskSetShift(!m_oskShift);
+  }
+}
