+  // '\0' marks a slot the symbol layer leaves empty.
+  char oskKeyChar(std::size_t index, bool shift, bool caps, bool symbols) {
+    if (symbols) {
+      for (std::size_t r = 0; r < kOskPlainRows.size(); ++r) {
+        if (index < kOskPlainRows[r].size()) {
+          return index < kOskSymbolRows[r].size() ? kOskSymbolRows[r][index] : '\0';
+        }
+        index -= kOskPlainRows[r].size();
+      }
+      return '\0';
+    }
+    const char c = oskChars(shift)[index];
+    return caps && c >= 'a' && c <= 'z' ? static_cast<char>(c - 'a' + 'A') : c;
+  }
