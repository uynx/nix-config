<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.uynx.siteblock">
  <!-- setGlobalPrivateDnsModeSpecifiedHost probes the DNS host from this app's own process. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:label="Site block" android:allowBackup="false">
    <receiver android:name=".Admin" android:exported="true" android:permission="android.permission.BIND_DEVICE_ADMIN">
      <meta-data android:name="android.app.device_admin" android:resource="@xml/admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
